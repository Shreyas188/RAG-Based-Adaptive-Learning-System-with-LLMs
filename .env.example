# ============================================================
# RAG Adaptive Learning System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- OpenAI Configuration ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# ---- Fallback LLM (HuggingFace — used if OPENAI_API_KEY is empty) ----
HF_MODEL_NAME=google/flan-t5-base
USE_OPENAI=true

# ---- FastAPI Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=false

# ---- Streamlit Frontend ----
FRONTEND_PORT=8501
BACKEND_URL=http://localhost:8000

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=./vector_db/chroma_store
CHROMA_COLLECTION_NAME=ncert_physics

# ---- Embedding Model ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ---- Chunking ----
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---- Retrieval ----
TOP_K_RESULTS=5

# ---- Database ----
SQLITE_DB_PATH=./data/rag_system.db

# ---- Data Paths ----
UPLOAD_DIR=./data/uploads

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# ---- Security ----
SECRET_KEY=change_this_to_a_long_random_secret_key
